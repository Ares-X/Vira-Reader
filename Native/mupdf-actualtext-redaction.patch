From ab37474fcb41d23acdbc0c6be3cf8c97d32dceff Mon Sep 17 00:00:00 2001
From: Sebastian Rasmussen <sebras@gmail.com>
Date: Fri, 6 Nov 2026 02:33:30 +0100
Subject: [PATCH] Bug 709973: Fix bug where redacted ActualText was never
 removed.

The problem was a typo in update_mcid() where the code attempted to
update the actualtext with a redacted string, but assigned this to
the /Alt key instead of the /ActulText key in the StructTree node.
---
 source/pdf/pdf-op-filter.c | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/source/pdf/pdf-op-filter.c b/source/pdf/pdf-op-filter.c
index f0d158b663..3add55fbe1 100644
--- a/source/pdf/pdf-op-filter.c
+++ b/source/pdf/pdf-op-filter.c
@@ -1,4 +1,4 @@
-// Copyright (C) 2004-2025 Artifex Software, Inc.
+// Copyright (C) 2004-2026 Artifex Software, Inc.
 //
 // This file is part of MuPDF.
 //
@@ -938,7 +938,7 @@ update_mcid(fz_context *ctx, pdf_sanitize_processor *p)
 	if (tag->alt.edited)
 		pdf_dict_put_text_string(ctx, tag->mcid_obj, PDF_NAME(Alt), tag->alt.utf8 ? tag->alt.utf8 : "");
 	if (tag->actualtext.edited)
-		pdf_dict_put_text_string(ctx, tag->mcid_obj, PDF_NAME(Alt), tag->actualtext.utf8 ? tag->actualtext.utf8 : "");
+		pdf_dict_put_text_string(ctx, tag->mcid_obj, PDF_NAME(ActualText), tag->actualtext.utf8 ? tag->actualtext.utf8 : "");
 }

 /* Process a string (from buf, of length len), from position *pos onwards.
